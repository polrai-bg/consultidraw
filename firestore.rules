rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clients and drawings - require authentication
    match /clients/{clientId} {
      allow read, write: if request.auth.uid != null;
    }
    match /clients/{clientId}/drawings/{drawingId} {
      allow read, write: if request.auth.uid != null;
    }
    match /clients/{clientId}/folders/{folderId} {
      allow read, write: if request.auth.uid != null;
    }
  }
}
